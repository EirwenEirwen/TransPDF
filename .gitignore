# ============================================================
# TransPDF .gitignore
# 铁律：模型权重绝不可入库。单文件 12GB+，GitHub 单文件硬上限 100MB、
# 单次 push 上限 2GB，push 会直接被拒；一旦进入提交历史，清理必须用
# git filter-repo 重写历史，代价极大。
# ============================================================

# ---- 模型权重 ----
models/
*.gguf
*.ggml
*.bin

# ---- 发布包与构建产物（均可由 build.bat 重新生成）----
release/
build/
dist/
*.spec.bak

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 运行时生成（含本机路径，不应公开）----
config.json
llama-server.log
.localserver.lock

# ---- 内部文档：不公开 ----
代码评审报告.md

# ---- 测试与临时输出 ----
test_out/
*.tmp
*.bak

# ============================================================
# 刻意不忽略的：
#   fonts/        发布包需要（思源黑体，OFL 许可可随软件分发），约 18MB
#   glossary.txt  可随源码分发的默认术语表
#   tools/verify_*.py  回归验证脚本，克隆后可直接重跑
# ============================================================
